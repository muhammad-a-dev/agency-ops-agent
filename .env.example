# Sandbox directory for tool file I/O (must stay inside this tree)
AGENCY_OPS_WORKSPACE_DIR=./workspace

# Agent loop limits
AGENCY_OPS_MAX_STEPS=8
AGENCY_OPS_HTTP_TIMEOUT_SECONDS=10.0
AGENCY_OPS_HTTP_MAX_BYTES=1048576

# Optional JSONL audit log (empty = in-memory only)
AGENCY_OPS_AUDIT_LOG_PATH=

# Optional LLM path (OFF by default — CI/tests need no API keys)
AGENCY_OPS_AGENT_LLM_ENABLED=false
AGENCY_OPS_OPENAI_API_KEY=
AGENCY_OPS_OPENAI_MODEL=gpt-4o-mini
AGENCY_OPS_OPENAI_BASE_URL=https://api.openai.com/v1

# Logging
AGENCY_OPS_LOG_LEVEL=INFO
